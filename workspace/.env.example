# Copy this file to `.env` and fill in Club Ralley's own Supabase project.
# Leave it empty / unset and the app runs in LOCAL mode (data stays in this
# browser only) — good for trying it out before the database is set up.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which board row to use in the shared database. Only matters once Supabase is
# wired. Leave as "clubralley" unless you want a second, separate board.
VITE_BOARD_ID=clubralley
